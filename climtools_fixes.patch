-version = "0.1.0"
-description = "Utilities for climate data analysis and plotting."
-readme = "README.md"
-license = "MIT"
-requires-python = ">=3.12"
-authors = [{ name = "Jared M Kodero" }]
-
-# Every entry below is imported somewhere in climtools's own source (not
-# transitively pulled in by another dependency). netCDF4 and mpi4py in
-# particular must be built against a parallel-enabled HDF5/NetCDF-C stack
-# for `climtools.xgeo.to_netcdf(..., parallel=True)`; see
-# env/setup_env.sh, which builds that stack from HPC environment
-# modules or from source (never a distro package manager, which is not
-# available on HPC login/compute nodes).
-dependencies = [
-    "numpy",
-    "pandas",
-    "scipy",
-    "xarray",
-    "dask[array,distributed]",
-    "cftime",
-    "netCDF4",
-    "cf_xarray",
-    "mpi4py>=3.1",
-    "matplotlib",
-    "cartopy",
-    "seaborn",
-    "cmocean",
-    "pymannkendall",
-    "ipython",
-    "rich",
-]
-
-[project.optional-dependencies]
-# xesmf is imported only inside climtools.xgeo.remap on first call; the rest
-# of the package works without it. Its ESMF dependency is far more reliable
-# from conda-forge than from pip; see environment.yml.
-regrid = ["xesmf"]
-dev = ["ruff", "typing_extensions"]
-
-[tool.setuptools]
-packages = [
-    "climtools",
-    "climtools.accessors",
-    "climtools.cdo",
-    "climtools.core",
-    "climtools.lib_netcdf",
-    "climtools.viz",
-]
-package-dir = { climtools = "../" }
-
-[tool.setuptools.package-data]
-"climtools.core" = ["data/**/*"]
-"climtools.viz" = ["data/**/*"]
\ No newline at end of file
