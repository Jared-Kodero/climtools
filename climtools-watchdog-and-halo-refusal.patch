-    return mpi.watchdog(label, timeout=timeout)
+    return mpi.watchdog(
+        label,
+        timeout=_WATCHDOG_TIMEOUT if timeout is None else timeout,
+        abort=False,
+        progress=lambda: _LAST_PROGRESS,
+    )
 
 
