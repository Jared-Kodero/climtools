@@ -0,0 +1,100 @@
+"""Regression tests for MPIXarray.halo_exchange (via the Arithmetic engine).
+
+Run under a real multi-rank launch:
+
+    mpirun --oversubscribe -n 4 python -m pytest tests/mpi/test_halo_exchange.py
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+import xarray as xr
+from mpi4py import MPI
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2].parent))
+
+from climtools.mpi.runtime import MPIRuntime
+from climtools.xarray.arithmetic import halo_exchange
+from climtools.xarray.io import mpi_partition_data
+
+COMM = MPI.COMM_WORLD
+RUNTIME = MPIRuntime(COMM)
+
+
+def test_halo_values_correct_including_static_passthrough():
+    """Sequential data makes the padded values checkable by construction;
+    a static (non-partition-dim) variable must pass through untouched with
+    zero communication.
+    """
+    rank = COMM.rank
+    if rank == 0:
+        nx, ny = 23, 4
+        data = np.arange(nx * ny, dtype="float64").reshape(nx, ny)
+        static = (np.arange(ny, dtype="int32") * 100)
+        ds = xr.Dataset(
+            {"v": (("x", "y"), data), "s": ("y", static)},
+            coords={"x": np.arange(nx), "y": np.arange(ny)},
+        )
+    else:
+        ds = None
+        data = None
+        static = None
+
+    distributed = mpi_partition_data(ds, RUNTIME, dim="x")
+    before, after = 2, 3
+    padded, left_pad, right_pad = halo_exchange(
+        RUNTIME, distributed._prepare(), "x", before=before, after=after
+    )
+
+    local_len = distributed.data.sizes["x"]
+    start = distributed.meta["start"]
+    global_x = np.arange(start - left_pad, start + local_len + right_pad)
+
+    full = COMM.bcast(data, root=0)
+    static_full = COMM.bcast(static, root=0)
+
+    assert np.array_equal(padded["v"].values, full[global_x, :])
+    assert np.array_equal(padded["s"].values, static_full)
+
+
+def test_halo_exchange_handles_multi_mb_multivariable_payload():
+    """Regression test for a real crash: mpi4py's comm.irecv(source=...)
+    without an explicit buffer defaults to a 256 KiB receive buffer, and
+    the previous pickled-Dataset implementation of halo_exchange silently
+    exceeded it for a realistic multi-variable, wide-grid exchange --
+    reproduced directly as a segfault (`malloc(): corrupted top size`)
+    against the pre-fix code, not a clean Python exception. This exercises
+    a payload roughly 24x that old threshold per variable.
+    """
+    rank = COMM.rank
+    if rank == 0:
+        nx, ny = 200, 8000
+        rng = np.random.default_rng(0)
+        ds = xr.Dataset(
+            {f"v{i}": (("x", "y"), rng.standard_normal((nx, ny)).astype("float64")) for i in range(6)},
+            coords={"x": np.arange(nx), "y": np.arange(ny)},
+        )
+    else:
+        ds = None
+
+    distributed = mpi_partition_data(ds, RUNTIME, dim="x")
+    padded, left_pad, right_pad = halo_exchange(
+        RUNTIME, distributed._prepare(), "x", before=4, after=4
+    )
+    expected_len = distributed.data.sizes["x"] + left_pad + right_pad
+    assert padded.sizes["x"] == expected_len
+
+
+def test_halo_exchange_zero_width_is_noop():
+    rank = COMM.rank
+    ds = xr.Dataset({"v": ("x", np.arange(20.0))}, coords={"x": np.arange(20)}) if rank == 0 else None
+    distributed = mpi_partition_data(ds, RUNTIME, dim="x")
+    padded, left_pad, right_pad = halo_exchange(
+        RUNTIME, distributed._prepare(), "x", before=0, after=0
+    )
+    assert left_pad == 0 and right_pad == 0
+    assert padded.sizes["x"] == distributed.data.sizes["x"]
diff --git a/tests/mpi/test_parallel_netcdf_io.py b/tests/mpi/test_parallel_netcdf_io.py
new file mode 100644
index 0000000..7795766
--- /dev/null
+++ b/tests/mpi/test_parallel_netcdf_io.py
@@ -0,0 +1,145 @@
+"""Regression tests for MPI-parallel NetCDF-4 output.
+
+Run under a real multi-rank launch, e.g.::
+
+    mpirun --oversubscribe -n 4 python -m pytest tests/mpi/test_parallel_netcdf_io.py
+
+Each test compares the MPI-parallel write against a native ``xarray``
+write of the identical Dataset and asserts exact equality (dims, coords,
+dtype, values, attrs) via ``xr.testing.assert_identical``. Assertions run
+on rank 0 only, but every rank must execute the same collective calls, so
+assertion failures are still raised (not silently swallowed) by letting
+a rank-0 AssertionError propagate normally -- pytest under mpirun reports
+per-rank output separately; a non-zero exit code on any rank fails the run.
+
+Partition sizes are deliberately NOT divisible by common rank counts
+(23, 29, 37 rows) to exercise uneven decomposition, which is where
+Scatterv/Gatherv offset and indexing bugs are most likely to surface.
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+import xarray as xr
+from mpi4py import MPI
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2].parent))
+
+from climtools.mpi.runtime import MPIRuntime
+from climtools.xarray.io import empty_dataset, mpi_partition_data, to_netcdf
+
+COMM = MPI.COMM_WORLD
+RUNTIME = MPIRuntime(COMM)
+
+
+def _make_dataset(nx: int, ny: int, dtype: str, seed: int) -> xr.Dataset:
+    rng = np.random.default_rng(seed)
+    if np.dtype(dtype).kind in ("i", "u"):
+        arr = rng.integers(-1000, 1000, size=(nx, ny)).astype(dtype)
+    else:
+        arr = rng.standard_normal((nx, ny)).astype(dtype)
+    return xr.Dataset(
+        {"v": (("x", "y"), arr)},
+        coords={"x": np.arange(nx), "y": np.arange(ny)},
+        attrs={"units": "arbitrary"},
+    )
+
+
+def _assert_matches_native(mpi_path: Path, ds: xr.Dataset, ref_path: Path) -> None:
+    """Rank-0-only: write ``ds`` natively and compare byte-for-byte semantics."""
+    ds.to_netcdf(ref_path)
+    a = xr.open_dataset(mpi_path)
+    b = xr.open_dataset(ref_path)
+    assert a["v"].dtype == ds["v"].dtype, (
+        f"dtype not preserved: got {a['v'].dtype}, expected {ds['v'].dtype}"
+    )
+    xr.testing.assert_identical(a, b)
+    a.close()
+    b.close()
+
+
+@pytest.mark.parametrize(
+    ("nx", "ny", "dtype"),
+    [
+        (23, 5, "float32"),  # uneven, regression case for the mpi_partitioned
+        (37, 11, "float32"),  # attrs bug (see git history: strip_export_attrs)
+        (32, 3, "int32"),  # even partition, integer dtype
+        (40, 3, "float64"),  # even partition, float64
+    ],
+)
+def test_to_netcdf_parallel_rank0_source_matches_native(tmp_path_factory, nx, ny, dtype):
+    """Rank 0 owns the complete object; the writer scatters it during write.
+
+    Regression coverage for two bugs found in this exact path:
+
+    - ``MPIXarrayOps`` was unimported in ``netcdf.py``, raising ``NameError``
+      the first time ``to_netcdf_parallel``'s already-distributed branch
+      called ``attach_save_chunks`` (fixed by a deferred import).
+    - ``MPIRuntime.scatterv`` did not exist at all; ``write_partitioned``
+      called it unconditionally on this rank-0-source path. Implemented as
+      a proper ``MPI_Scatterv``-based leading-axis scatter.
+    """
+    rank = COMM.rank
+    if rank == 0:
+        ds = _make_dataset(nx, ny, dtype, seed=hash((nx, ny, dtype)) % (2**31))
+        tmp_dir = tmp_path_factory.mktemp("rank0_source")
+    else:
+        ds = empty_dataset()
+        tmp_dir = None
+    tmp_dir = COMM.bcast(tmp_dir, root=0)
+
+    out_path = tmp_dir / f"out_{nx}_{ny}_{dtype}.nc"
+    to_netcdf(ds, out_path, mpi_runtime=RUNTIME, partition_dim="x", parallel=True, show_progress=False)
+    COMM.Barrier()
+
+    if rank == 0:
+        ref_path = tmp_dir / f"ref_{nx}_{ny}_{dtype}.nc"
+        _assert_matches_native(out_path, ds, ref_path)
+    COMM.Barrier()
+
+
+@pytest.mark.parametrize(
+    ("nx", "ny", "dtype"),
+    [
+        (37, 11, "float32"),  # regression case for the mpi_partitioned attrs bug
+        (29, 2, "int32"),
+    ],
+)
+def test_to_netcdf_parallel_predistributed_matches_native(tmp_path_factory, nx, ny, dtype):
+    """Object is already distributed via ``mpi_partition_data`` before writing.
+
+    Regression coverage for the ``mpi_partitioned`` boolean-attribute bug:
+    ``MPIXarray.__init__`` stamps ``attrs["mpi_partitioned"] = True`` (a
+    Python bool) on the object and every distributed variable via
+    ``mark_partitioned``. NetCDF4 attributes do not support a boolean
+    dtype, so writing a freshly partitioned (not reopened) object through
+    this path used to fail schema creation with ``TypeError: illegal data
+    type for attribute b'mpi_partitioned' ... got b1`` on every call,
+    fixed by ``strip_export_attrs`` (see ``xarray/meta.py``), which is now
+    the single filter every NetCDF attribute-writing site in
+    ``xarray/netcdf.py`` uses instead of six separately maintained
+    ``if key != MPI_META`` comprehensions (one of which never excluded the
+    partition marker at all).
+    """
+    rank = COMM.rank
+    if rank == 0:
+        ds = _make_dataset(nx, ny, dtype, seed=hash((nx, ny, dtype, "predist")) % (2**31))
+        tmp_dir = tmp_path_factory.mktemp("predistributed")
+    else:
+        ds = None
+        tmp_dir = None
+    tmp_dir = COMM.bcast(tmp_dir, root=0)
+
+    distributed = mpi_partition_data(ds, RUNTIME, dim="x")
+    out_path = tmp_dir / f"out_{nx}_{ny}_{dtype}.nc"
+    distributed.to_netcdf(out_path, partition_dim="x", parallel=True, show_progress=False)
+    COMM.Barrier()
+
+    if rank == 0:
+        ref_path = tmp_dir / f"ref_{nx}_{ny}_{dtype}.nc"
+        _assert_matches_native(out_path, ds, ref_path)
+    COMM.Barrier()
