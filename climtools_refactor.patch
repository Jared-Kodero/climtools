diff --git a/tests/mpi/test_core_ops_baseline.py b/tests/mpi/test_core_ops_baseline.py
new file mode 100644
index 0000000..5141733
--- /dev/null
+++ b/tests/mpi/test_core_ops_baseline.py
@@ -0,0 +1,173 @@
+"""Baseline correctness tests for core MPIXarray operations vs native xarray.
+
+Purpose: a regression gate for the IO/MPIXarrayOps class-hierarchy refactor
+(module-level functions replacing the stateless mixin classes). These tests
+capture *current* (pre-refactor) behavior across the operations most likely
+to be touched by that refactor (partition/repartition, reductions that
+depend on each other via self.<method> MRO calls, indexing). Run this file
+before and after each refactor step; any diff in pass/fail is a regression
+the refactor introduced, not a pre-existing issue.
+
+Run under a real multi-rank launch:
+
+    mpirun --oversubscribe -n 4 python -m pytest tests/mpi/test_core_ops_baseline.py
+"""
+
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+import numpy as np
+import pytest
+import xarray as xr
+from mpi4py import MPI
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2].parent))
+
+from climtools.mpi.runtime import MPIRuntime
+from climtools.xarray.io import mpi_partition_data
+from climtools.xarray.meta import strip_mpi_meta
+
+COMM = MPI.COMM_WORLD
+RUNTIME = MPIRuntime(COMM)
+
+
+def _reference_dataset(nx=37, ny=5, seed=0):
+    rng = np.random.default_rng(seed)
+    arr = rng.standard_normal((nx, ny)).astype("float32")
+    arr[::7, 0] = np.nan  # exercise skipna paths
+    return xr.Dataset(
+        {"v": (("x", "y"), arr)},
+        coords={"x": np.arange(nx), "y": np.arange(ny)},
+        attrs={"units": "K"},
+    )
+
+
+def _distribute(ds_or_none):
+    return mpi_partition_data(ds_or_none, RUNTIME, dim="x")
+
+
+def _gather_to_native(distributed):
+    """Collect a distributed MPIXarray's local slices onto rank 0, ordered by
+    each rank's mpi_meta start offset. climtools has no dedicated "gather"
+    call (by design -- data is meant to stay distributed); this is test-only
+    plumbing using a plain comm.gather + ordered concat, not part of the
+    library's public API.
+    """
+    meta = distributed.meta
+    if meta is None:
+        return distributed.data if distributed._runtime.comm.rank == 0 else None
+    dim = meta["dim"]
+    start = meta["start"]
+    pieces = distributed._runtime.comm.gather((start, distributed.data), root=0)
+    if distributed._runtime.comm.rank != 0:
+        return None
+    pieces.sort(key=lambda item: item[0])
+    ordered = [strip_mpi_meta(piece) for _, piece in pieces]
+    if isinstance(ordered[0], xr.Dataset):
+        return xr.concat(ordered, dim=dim, data_vars="minimal")
+    return xr.concat(ordered, dim=dim)
+
+
+@pytest.mark.parametrize("op", ["sum", "mean", "min", "max", "std", "var", "any", "all"])
+def test_reduction_matches_native(op):
+    rank = COMM.rank
+    ds = _reference_dataset() if rank == 0 else None
+    distributed = _distribute(ds)
+
+    # partition_dim=None: reduction API documents this as the plain
+    # replicated result (every rank holds the same value), matching what a
+    # native xarray reduction returns. The default "auto" instead
+    # redistributes the result onto the largest surviving dimension by
+    # design, which is not what this test compares against.
+    mpi_result = getattr(distributed, op)("x", partition_dim=None)
+
+    if rank == 0:
+        native = getattr(ds, op)("x", skipna=True) if op not in ("any", "all") else getattr(ds, op)("x")
+        xr.testing.assert_allclose(mpi_result.data, native, rtol=1e-5, atol=1e-6)
+
+
+@pytest.mark.parametrize("op", ["first", "last"])
+def test_first_last_matches_native(op):
+    """xarray has no Dataset.first()/.last(); the equivalent of "first/last
+    valid value along dim" is bfill (first)/ffill (last) then take the edge
+    position -- see climtools' own docstring: "Select the first valid value
+    along one dimension."
+    """
+    rank = COMM.rank
+    ds = _reference_dataset() if rank == 0 else None
+    distributed = _distribute(ds)
+
+    mpi_result = getattr(distributed, op)("x", skipna=True, partition_dim=None)
+
+    if rank == 0:
+        if op == "first":
+            native = ds.bfill("x").isel(x=0, drop=True)
+        else:
+            native = ds.ffill("x").isel(x=-1, drop=True)
+        # climtools' first/last additionally attach an "x" coordinate
+        # recording which row each per-column value came from -- useful,
+        # but with no equivalent in the naive bfill/ffill+isel comparison,
+        # so compare data values only.
+        xr.testing.assert_allclose(
+            mpi_result.data.drop_vars("x", errors="ignore"), native, rtol=1e-5, atol=1e-6
+        )
+
+
+@pytest.mark.parametrize(("start", "stop"), [(2, 30), (0, 10), (5, 37)])
+def test_isel_matches_native(start, stop):
+    rank = COMM.rank
+    ds = _reference_dataset() if rank == 0 else None
+    distributed = _distribute(ds)
+
+    sliced = distributed.isel(x=slice(start, stop))
+    gathered = _gather_to_native(sliced)
+
+    if rank == 0:
+        native = ds.isel(x=slice(start, stop))
+        xr.testing.assert_identical(gathered, native)
+
+
+def test_repartition_roundtrip_preserves_data():
+    """partition -> gather reproduces the original."""
+    rank = COMM.rank
+    ds = _reference_dataset(nx=29) if rank == 0 else None
+    distributed = _distribute(ds)
+    gathered = _gather_to_native(distributed)
+
+    if rank == 0:
+        xr.testing.assert_identical(gathered, ds)
+
+
+def test_groupby_reduce_matches_native():
+    rank = COMM.rank
+    if rank == 0:
+        nx = 40
+        rng = np.random.default_rng(3)
+        arr = rng.standard_normal((nx,)).astype("float32")
+        labels = np.array([f"g{i % 4}" for i in range(nx)])
+        ds = xr.Dataset({"v": ("x", arr)}, coords={"x": np.arange(nx)})
+        full_labels = labels
+    else:
+        ds = None
+        full_labels = None
+    full_labels = COMM.bcast(full_labels, root=0)
+
+    distributed = _distribute(ds)
+    meta = distributed.meta
+    local_labels = full_labels[meta["start"] : meta["stop"]]
+
+    # climtools' groupby takes the dimension and this rank's local label
+    # array directly (not a coordinate name, unlike xarray.Dataset.groupby),
+    # and partition_dim=None requests the plain replicated result to match
+    # what native xarray's groupby returns.
+    result = distributed.groupby("x", local_labels).mean(partition_dim=None)
+
+    if rank == 0:
+        group_dim = next(iter(result.data.dims))
+        native = ds.assign_coords(grp=("x", labels)).groupby("grp").mean()
+        native = native.rename(grp=group_dim)
+        xr.testing.assert_allclose(
+            result.data.sortby(group_dim), native.sortby(group_dim), rtol=1e-5
+        )
