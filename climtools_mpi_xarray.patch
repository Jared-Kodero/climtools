+            result = strip_mpi_meta(value).reindex(
+                indexers, method=method, tolerance=tolerance, fill_value=fill_value
+            )
+            set_mpi_meta(
+                result,
+                dim=meta["dims"],
+                global_size=meta["global_sizes"],
+                start=meta["starts"],
+                stop=meta["stops"],
+                chunk_info=prune_chunk_info(meta["chunk_info"], result),
+                cart=meta.get("cart"),
+            )
