+def test_get_effective_chunk_size_and_usable_native_chunk() -> None:
+    """A short or missing native chunk falls back to a balanced per-rank
+    length; a genuinely multi-chunk native size is kept as-is."""
+    check(
+        "get_usable_native_chunk: None native chunk is unusable",
+        get_usable_native_chunk(100, None) is False,
+    )
+    check(
+        "get_usable_native_chunk: chunk >= length gives only one chunk, unusable",
+        get_usable_native_chunk(10, 10) is False,
+    )
+    check(
+        "get_usable_native_chunk: chunk smaller than length is usable",
+        get_usable_native_chunk(100, 10) is True,
+    )
+
+    check(
+        "get_effective_chunk_size: length <= 0 returns 1",
+        get_effective_chunk_size(0, None, SIZE) == 1,
+    )
+    check(
+        "get_effective_chunk_size: no usable native chunk balances across ranks",
+        get_effective_chunk_size(97, None, SIZE) == max(1, int(np.ceil(97 / SIZE))),
+    )
+    check(
+        "get_effective_chunk_size: usable native chunk is kept verbatim",
+        get_effective_chunk_size(100, 10, SIZE) == 10,
+    )
+
