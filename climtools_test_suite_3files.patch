+def test_choose_partition_dim_selection() -> None:
+    """choose_partition_dim's selection rules: longest wins, declaration-order
+    tie-breaking, ``exclude``, the length-one fallback, and the ``ValueError``
+    raised with no candidate dimensions."""
+    check(
+        "choose_partition_dim: longest dimension wins",
+        xr_meta.choose_partition_dim({"lat": 4, "lon": 10, "time": 6}, mpi_size=SIZE)
+        == "lon",
+    )
+    check(
+        "choose_partition_dim: ties break by declaration order",
+        xr_meta.choose_partition_dim({"a": 5, "b": 5, "c": 5}, mpi_size=SIZE) == "a",
+    )
+    check(
+        "choose_partition_dim: excluded dims are never chosen",
+        xr_meta.choose_partition_dim(
+            {"time": 100, "lat": 10}, mpi_size=SIZE, exclude=("time",)
+        )
+        == "lat",
+    )
+    check(
+        "choose_partition_dim: avoids length-one dims when a longer one exists",
+        xr_meta.choose_partition_dim({"member": 1, "lat": 3}, mpi_size=SIZE) == "lat",
+    )
+    check(
+        "choose_partition_dim: falls back to length-one when nothing else exists",
+        xr_meta.choose_partition_dim({"member": 1}, mpi_size=SIZE) == "member",
+    )
+    raised = False
+    try:
+        xr_meta.choose_partition_dim({}, mpi_size=SIZE)
+    except ValueError:
+        raised = True
+    check("choose_partition_dim: raises ValueError with no candidates", raised)
