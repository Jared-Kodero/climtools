+def test_open_dataset_partitioned() -> None:
+    """mpi.xarray.open_dataset lazily distributes a real NetCDF file along
+    the requested dimension, and rejects an unknown partition_dim."""
+    distributed = mpi.xarray.open_dataset(
+        str(mock_dataset.TEST_DATA_PATH), partition_dim="lat", log_partitions=False
+    )[["pr"]]
+    local = distributed["pr"].isel(time=0).load().values
+    meta = distributed.attrs.get("mpi_meta")
+
+    parts = mpi.comm.allgather(local)
+    axis = distributed["pr"].isel(time=0).get_axis_num("lat")
+    assembled = np.concatenate(parts, axis=axis)
+    expected = mock_dataset.load_test_variable("pr", time=0).values
+    distributed.close()
+
+    check(
+        "open_dataset: assembled shards equal the file's own values",
+        bool(np.array_equal(assembled, expected)),
+    )
+    check(
+        "open_dataset: mpi_meta partitions on the requested dim, spans the file",
+        isinstance(meta, dict)
+        and meta.get("dim") == "lat"
+        and int(meta.get("global_size", -1)) == mock_dataset.LATITUDE_COUNT,
+    )
+    check(
+        "open_dataset: rejects a partition_dim that isn't in the file",
+        call_raises(
+            (ValueError, mpi.MPIError),
+            mpi.xarray.open_dataset,
+            str(mock_dataset.TEST_DATA_PATH),
+            partition_dim="not_a_real_dim",
+            contains="partition_dim",
+        ),
+    )
+
