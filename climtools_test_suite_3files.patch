+def test_reduction_dtype_contracts() -> None:
+    """A dtype with no predefined MPI datatype is rejected on every rank,
+    before any collective is posted; ordinary dtypes reduce with the
+    correct result dtype even when some ranks own zero elements."""
+    unsupported = xr.DataArray(
+        np.zeros(SIZE + 1, dtype=np.float16), dims=("t",), name="v"
+    )
+    distributed = mpi.xarray.repartition(unsupported, "t")
+    raised = False
+    try:
+        mpi.xarray.sum(distributed, dim="t")
+    except TypeError as exc:
+        raised = "Unsupported MPI xarray dtype" in str(exc)
+    check("sum: rejects a dtype with no predefined MPI datatype (float16)", raised)
+
+    for dtype in (np.int8, np.int32, np.float32, np.float64):
+        field = xr.DataArray(
+            np.arange(max(1, SIZE - 1), dtype=dtype), dims=("t",), name="v"
+        )
+        distributed = mpi.xarray.repartition(field, "t")
+        for op in ("min", "max"):
+            got = getattr(mpi.xarray, op)(distributed, dim="t")
+            # bottleneck, when installed, silently promotes a float32
+            # min/max reduction to float64; disabling it here keeps the
+            # serial reference itself dtype-stable across environments,
+            # rather than testing an artifact of an optional dependency.
+            with xr.set_options(use_bottleneck=False):
+                ref = getattr(field, op)(dim="t")
+            check(
+                f"{op} ({np.dtype(dtype)}): result dtype matches the serial reference",
+                got.dtype == ref.dtype,
+            )
+            check(
+                f"{op} ({np.dtype(dtype)}): result value matches the serial reference",
+                float(got.item()) == float(ref.item()),
+            )
+
+
+def test_empty_partition_reductions() -> None:
+    """A dimension shorter than the communicator leaves trailing ranks
+    empty; those ranks build their local partial through a different code
+    path, so this is exactly the configuration where a reduction could post
+    a different number of collectives per rank and deadlock instead of
+    just returning the right answer."""
+    for length in sorted({1, max(1, SIZE // 2), max(1, SIZE - 1), SIZE, SIZE + 1}):
+        field = xr.DataArray(
+            np.arange(length, dtype=np.float64) + 1.0, dims=("t",), name="v"
+        )
+        distributed = mpi.xarray.repartition(field, "t")
+        for op in ("sum", "mean", "min", "max"):
+            got = getattr(mpi.xarray, op)(distributed, dim="t")
+            ref = getattr(field, op)(dim="t")
+            check(
+                f"{op}: correct with length {length} over {SIZE} rank(s) "
+                "(some ranks may own zero elements)",
+                bool(np.isclose(float(got.item()), float(ref.item()))),
+            )
+
