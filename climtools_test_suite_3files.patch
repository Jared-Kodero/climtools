+def test_indexer_is_scalar() -> None:
+    """A slice/list/tuple/ndarray/DataArray indexer is not scalar; else it is."""
+    non_scalar = (
+        slice(0, 1),
+        [0, 1],
+        (0, 1),
+        np.array([0, 1]),
