+def test_create_dataset_reports_coordinate_edges() -> None:
+    """The partition report's (first, last) columns are populated -- not
+    '-' -- when the partitioned dim carries a real, on-disk coordinate.
+
+    Builds the mock NetCDF file climtools' own performance suite uses
+    (mock_dataset.build_mock_dataset, trimmed for speed) instead of a
+    hand-built numpy coordinate, so this exercises the decoded,
+    disk-backed 'time' coordinate a real create_dataset() caller would
+    pass -- e.g. re-chunking a variable read from one file into another
+    distributed Dataset -- not merely an array with the right shape.
+    """
+    n_time, n_lat, n_lon = 30, 3, 4
+    path = mock_dataset_path(n_time, n_lat, n_lon)
+    try:
+        with xr.open_dataset(path, decode_times=False) as source:
+            time = source["time"].values.copy()
+
+            def fill_pr(start: int, stop: int) -> np.ndarray:
+                return source["pr"].isel(time=slice(start, stop)).load().values
+
+            ds = mpi.xarray.create_dataset(
+                {"pr": (["time", "lat", "lon"], fill_pr)},
+                sizes={"lat": n_lat, "lon": n_lon},
+                dim="time",
+                coords={"time": time},
+                log_partitions=False,
+            )
+            meta = get_mpi_meta(ds)
+            assert meta is not None
+            start, stop = meta["start"], meta["stop"]
+            check(
+                "create_dataset: local 'time' coordinate matches the on-disk file",
+                bool((ds["time"].values == time[start:stop]).all()),
+            )
+            check(
+                "create_dataset: local 'pr' matches the on-disk file at the "
+                "same time slice",
+                bool(
+                    np.array_equal(
+                        ds["pr"].values,
+                        source["pr"].isel(time=slice(start, stop)).values,
+                    )
+                ),
+            )
+    finally:
+        cleanup_mock_dataset(path)
+
