+"""Mock NetCDF dataset(s) for the climtools MPI test suite.
+
+Two tiers, both rank-0-writes/broadcast-filename/barrier-before-read (the
+pattern climtools' own performance suite uses for its ``TEST_DATA_PATH``):
+
+- :func:`setup_shared_dataset` builds one on-disk, multi-variable,
+  geophysical-shaped dataset ("pr", "t2m", "t", "slmsk" over
+  time/plev/lat/lon) *once* per test run. ``test_mpi.py`` (the
+  orchestrator) calls it before dispatching to any ``test_mpi_*.py``
+  module, and every module reads its shape from this module's
+  ``TEST_DATA_PATH``/``LATITUDE_COUNT``/``LONGITUDE_COUNT``/``PLEV_COUNT``/
+  ``TIME_STEPS`` constants rather than building its own copy, so every
+  test -- and every rank -- agrees on the same file and the same shapes.
+- :func:`write_and_load` and :func:`mock_dataset_path` build a small,
+  single-purpose file for one test in isolation (used by
+  ``mpi_fixtures.py``'s ``make_series``/``make_field``/``make_dataset`` and
+  by the ``create_dataset`` coordinate-edges regression in
+  ``test_mpi_io.py``), independent of the shared dataset's lifetime.
+"""
+
+from __future__ import annotations
+
+import shutil
+import uuid
+from collections.abc import Callable
+from pathlib import Path
+
+import numpy as np
+from climtools import mpi
+from mpi4py import MPI
+
+import xarray as xr
+
+_OUTPUT_DIR = (Path.home() / "jobtmp" / "climtools_mock_dataset_test").resolve()
+
+# Populated by setup_shared_dataset(); read (not written) by every
+# test_mpi_*.py module that needs the shared geophysical mock file.
+TEST_DATA_PATH: Path | None = None
+LATITUDE_COUNT: int = 0
+LONGITUDE_COUNT: int = 0
+PLEV_COUNT: int = 0
+TIME_STEPS: int = 0
+
+
+# ---------------------------------------------------------------------------
+# Shared, whole-suite geophysical mock dataset
+# ---------------------------------------------------------------------------
+
+
+def build_shared_dataset(
+    path: Path,
+    n_time: int,
+    resolution_deg: float,
+    plev_step: float,
+) -> None:
+    """Write a deterministic (time, plev, lat, lon) geophysical mock file.
+
+    Four variables, matching what the split ``test_mpi_*.py`` modules
+    exercise: "pr" and "t2m" vary over (time, lat, lon), "t" is one static
+    (plev, lat, lon) profile (a full time-varying pressure-level field is
+    unnecessary for any test here and would dominate build time), "slmsk"
+    is an integer (lat, lon) land mask. Same formula shapes as climtools'
+    own performance suite's mock dataset, at sizes meant for fast unit
+    tests rather than profiling.
+    """
+    if isinstance(n_time, bool) or not isinstance(n_time, int) or n_time < 1:
+        raise ValueError("n_time must be a positive integer.")
+
+    time = np.arange(n_time, dtype=np.float64)
+    n_lat = int(180 / resolution_deg) + 1
+    lat = np.linspace(-90, 90, n_lat, dtype=np.float32)
+    n_lon = int(360 / resolution_deg)
+    lon = np.linspace(-180, 180, n_lon, endpoint=False, dtype=np.float32)
+    plev = np.arange(1000.0, -1.0, plev_step, dtype=np.float32)
+
+    lat_rad = np.deg2rad(lat)[None, :, None]
+    lon_rad = np.deg2rad(lon)[None, None, :]
+    time_phase = (time % 24.0)[:, None, None]
+
+    precipitation = (
+        1.0e-4
+        * (1.25 + np.cos(lat_rad) ** 2)
+        * (1.0 + 0.15 * np.sin(lon_rad))
+        * (1.0 + 0.01 * time_phase)
+    ).astype(np.float32)
+
+    surface_temperature_base = (
+        288.0 - 42.0 * np.sin(lat_rad) ** 2 + 2.0 * np.cos(lon_rad)
+    ).astype(np.float32)
+    surface_temperature = (surface_temperature_base + 0.05 * time_phase).astype(
+        np.float32
+    )
+
+    pressure_cooling = (7.0 * np.log(1000.0 / plev.astype(np.float64))).astype(
+        np.float32
+    )[:, None, None]
+    air_temperature = surface_temperature_base[0][None, :, :] - pressure_cooling
+
+    lat_index = np.arange(n_lat)[:, None]
+    lon_index = np.arange(n_lon)[None, :]
+    sea_land_mask = ((lat_index + lon_index) % 3).astype(np.int8)
+
+    ds = xr.Dataset(
+        data_vars={
+            "pr": (
+                ("time", "lat", "lon"),
+                precipitation,
+                {"units": "kg m-2 s-1", "long_name": "precipitation rate"},
+            ),
+            "t2m": (
+                ("time", "lat", "lon"),
+                surface_temperature,
+                {"units": "K", "long_name": "2 m air temperature"},
+            ),
+            "t": (
+                ("plev", "lat", "lon"),
+                air_temperature,
+                {"units": "K", "long_name": "air temperature"},
+            ),
+            "slmsk": (
+                ("lat", "lon"),
+                sea_land_mask.astype(np.int64),
+                {"units": "1", "long_name": "sea-land-ice mask"},
+            ),
+        },
+        coords={
+            "time": (
+                "time",
+                time.astype(np.float64),
+                {"units": "hours since 1970-01-01 00:00:00"},
+            ),
+            "plev": ("plev", plev, {"units": "hPa", "positive": "down"}),
+            "lat": ("lat", lat, {"units": "degrees_north"}),
+            "lon": ("lon", lon, {"units": "degrees_east"}),
+        },
+        attrs={"title": "climtools MPI test suite mock dataset"},
+    )
+    ds.to_netcdf(path, format="NETCDF4")
+
+
+def setup_shared_dataset(
+    n_time: int = 48,
+    resolution_deg: float = 10.0,
+    plev_step: float = -200.0,
+) -> Path:
+    """Build (rank 0) the shared mock dataset once, load shapes everywhere.
+
+    Call once, from the orchestrator, before any component test module
+    runs. Sets this module's ``TEST_DATA_PATH``/``LATITUDE_COUNT``/
+    ``LONGITUDE_COUNT``/``PLEV_COUNT``/``TIME_STEPS`` constants, which every
+    ``test_mpi_*.py`` module reads directly rather than rebuilding or
+    resizing its own copy.
+    """
+    global TEST_DATA_PATH
+
+    comm = mpi.comm
+    name = uuid.uuid4().hex if comm.rank == 0 else None
+    name = comm.bcast(name, root=0)
+    path = _OUTPUT_DIR / f"{name}.nc"
+
+    if comm.rank == 0:
+        if _OUTPUT_DIR.exists():
+            shutil.rmtree(_OUTPUT_DIR)
+        _OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
+        build_shared_dataset(path, n_time, resolution_deg, plev_step)
+    comm.barrier()
+
+    visible = bool(comm.allreduce(path.is_file(), op=MPI.LAND))
+    if not visible:
+        raise mpi.MPIError(f"shared mock dataset is not visible on every rank: {path}")
+
+    TEST_DATA_PATH = path
+    _load_shared_configuration(path)
+    return path
+
+
+def _load_shared_configuration(path: Path) -> None:
+    """Read shape constants from ``path`` and confirm every rank agrees.
+
+    Reading dimensions back from the file (rather than broadcasting the
+    build arguments) makes it a single source of truth every rank
+    evaluates identically; the explicit ``allgather`` check turns a
+    disagreement into an immediate, readable error instead of a much later
+    deadlock in a shape-dependent collective.
+    """
+    global LATITUDE_COUNT, LONGITUDE_COUNT, PLEV_COUNT, TIME_STEPS
+
+    with xr.open_dataset(path) as source:
+        LATITUDE_COUNT = int(source.sizes["lat"])
+        LONGITUDE_COUNT = int(source.sizes["lon"])
+        PLEV_COUNT = int(source.sizes["plev"])
+        TIME_STEPS = int(source.sizes["time"])
+
+    constants = (LATITUDE_COUNT, LONGITUDE_COUNT, PLEV_COUNT, TIME_STEPS)
+    gathered = mpi.comm.allgather(constants)
+    if len(set(gathered)) != 1:
+        raise mpi.MPIError(
+            f"shared mock dataset shape constants disagree across ranks: {gathered}"
+        )
+
+
+def teardown_shared_dataset() -> None:
+    """Remove the file built by :func:`setup_shared_dataset`, once."""
+    global TEST_DATA_PATH
+
+    mpi.comm.barrier()
+    if mpi.comm.rank == 0 and TEST_DATA_PATH is not None and TEST_DATA_PATH.exists():
+        TEST_DATA_PATH.unlink()
+    mpi.comm.barrier()
+    TEST_DATA_PATH = None
+
+
+def load_test_variable(variable: str, **indexers: int | slice) -> xr.DataArray:
+    """Load a variable selection from the shared mock dataset.
+
+    Every rank opens the same file concurrently; HDF5's default POSIX
+    advisory locks can block indefinitely on some filesystems, so
+    ``HDF5_USE_FILE_LOCKING=FALSE`` must be set in the environment running
+    these tests (matches climtools' own performance suite).
+    """
+    if TEST_DATA_PATH is None:
+        raise RuntimeError("setup_shared_dataset() has not been called.")
+    with xr.open_dataset(TEST_DATA_PATH) as source:
+        data = source[variable]
+        valid_indexers = {
+            dim: indexer for dim, indexer in indexers.items() if dim in data.dims
+        }
+        return data.isel(valid_indexers).load()
+
+
+def load_test_dataset(
+    variables: tuple[str, ...], **indexers: int | slice
+) -> xr.Dataset:
+    """Load selected variables and slices from the shared mock dataset."""
+    if TEST_DATA_PATH is None:
+        raise RuntimeError("setup_shared_dataset() has not been called.")
+    with xr.open_dataset(TEST_DATA_PATH) as source:
+        data = source[list(variables)]
+        valid_indexers = {
+            dim: indexer for dim, indexer in indexers.items() if dim in data.dims
+        }
+        return data.isel(valid_indexers).load()
+
+
+# ---------------------------------------------------------------------------
+# Lightweight, single-test mock files (independent of the shared dataset)
+# ---------------------------------------------------------------------------
+
+
+def build_mock_dataset(path: Path, n_time: int, n_lat: int, n_lon: int) -> None:
+    """Write a small, deterministic (time, lat, lon) precipitation-only file."""
+    time = np.arange(n_time, dtype=np.float64)
+    lat = np.linspace(-90, 90, n_lat, dtype=np.float32)
+    lon = np.linspace(-180, 180, n_lon, endpoint=False, dtype=np.float32)
+    precipitation = (
+        1.0e-4
+        * (1.25 + np.cos(np.deg2rad(lat))[None, :, None] ** 2)
+        * (1.0 + 0.15 * np.sin(np.deg2rad(lon))[None, None, :])
+        * (1.0 + 0.01 * (time % 24.0))[:, None, None]
+    ).astype(np.float32)
+
+    ds = xr.Dataset(
+        data_vars={
+            "pr": (
+                ("time", "lat", "lon"),
+                precipitation,
+                {"units": "kg m-2 s-1", "long_name": "precipitation rate"},
+            ),
+        },
+        coords={
+            "time": ("time", time, {"units": "hours since 1970-01-01 00:00:00"}),
+            "lat": ("lat", lat, {"units": "degrees_north"}),
+            "lon": ("lon", lon, {"units": "degrees_east"}),
+        },
+        attrs={"title": "climtools mock dataset (test fixture)"},
+    )
+    ds.to_netcdf(path, format="NETCDF4")
+
+
+def mock_dataset_path(n_time: int = 30, n_lat: int = 3, n_lon: int = 4) -> Path:
+    """Build (rank 0) or await (other ranks) a small, single-test mock file."""
+    comm = mpi.comm
+    name = uuid.uuid4().hex if comm.rank == 0 else None
+    name = comm.bcast(name, root=0)
+    path = _OUTPUT_DIR / f"{name}.nc"
+
+    if comm.rank == 0:
+        _OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
+        build_mock_dataset(path, n_time, n_lat, n_lon)
+    comm.barrier()
+    return path
+
+
+def cleanup_mock_dataset(path: Path) -> None:
+    """Remove a file built by :func:`mock_dataset_path`, once, from rank 0."""
+    mpi.comm.barrier()
+    if mpi.comm.rank == 0 and path.exists():
+        path.unlink()
+    mpi.comm.barrier()
+
+
+def write_and_load(build: Callable[[], xr.Dataset]) -> xr.Dataset:
+    """Write ``build()`` to NetCDF on rank 0, read it back (loaded) on every rank.
+
+    ``build`` returns an arbitrary in-memory :class:`xarray.Dataset`,
+    written once (rank 0); every rank -- including rank 0 -- then opens and
+    fully loads the *same on-disk file*. ``build`` itself must be
+    deterministic (e.g. seeded) since only rank 0 ever calls it.
+    """
+    comm = mpi.comm
+    name = uuid.uuid4().hex if comm.rank == 0 else None
+    name = comm.bcast(name, root=0)
+    path = _OUTPUT_DIR / f"{name}.nc"
+
+    if comm.rank == 0:
+        _OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
+        build().to_netcdf(path, format="NETCDF4")
+    comm.barrier()
+
+    with xr.open_dataset(path) as source:
+        loaded = source.load()
+
+    comm.barrier()
+    if comm.rank == 0 and path.exists():
+        path.unlink()
+    comm.barrier()
+    return loaded
