+    check(
+        "indexer_is_scalar: slice/list/tuple/ndarray/DataArray are not scalar",
+        all(not xr_meta.indexer_is_scalar(value) for value in non_scalar),
+    )
+    check(
+        "indexer_is_scalar: int/label/numpy scalar are scalar",
+        all(xr_meta.indexer_is_scalar(value) for value in scalar),
+    )
