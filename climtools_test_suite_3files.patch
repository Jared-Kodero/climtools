+    if mpi.comm.allreduce(local_len, op=MPI.MIN) < 3:
+        check(
+            "rolling_reduce sum window=4 center=False: skipped "
+            + "(a rank's slice is too small for this many ranks)",
+            True,
+        )
+        return
+    got = mpi.xarray.rolling_reduce(
