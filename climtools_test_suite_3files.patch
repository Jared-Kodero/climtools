+        bool(
+            np.array_equal(
+                distributed.values,
+                reference_distributed.sel(lat=distributed["lat"]).values,
+            )
+        ),
+    )
+    check(
+        "distribute: attaches mpi_meta on the partitioned dim",
+        meta is not None and meta["dim"] == "lat",
+    )
+    if SIZE > 1:
+        # A value on a non-root rank (rank 1) alongside the correct value on
+        # root triggers the per-rank ValueError inside distribute(), which
+        # raise_if_error then synchronizes across every rank: the offending
+        # rank(s) see the original ValueError, every other rank sees it
+        # wrapped as mpi.MPIError -- so every rank must call this together,
+        # and either exception type is a valid, synchronized outcome.
+        bad_value = (
+            source
+            if RANK == 0
+            else (mock_dataset.load_test_variable("t2m", time=0) if RANK == 1 else None)
+        )
+        check(
+            "distribute: rejects a value passed on a non-root rank",
+            call_raises(
+                (ValueError, mpi.MPIError),
+                mpi.xarray.distribute,
+                bad_value,
+                "lat",
+                root=0,
+            ),
+        )
+
