+def test_mpi_meta_round_trip() -> None:
+    """set_mpi_meta/get_mpi_meta/strip_mpi_meta agree on a rank-local
+    partition, reject a length mismatch, and fall back to a Dataset's
+    variable-level metadata when Dataset.attrs itself is empty."""
+    global_size = max(SIZE, 8)
+    start, stop = partition_bounds(global_size)
+    da = xr.DataArray(np.arange(stop - start, dtype=np.float64), dims=("x",), name="f")
+    check(
+        "get_mpi_meta: None before any metadata is set",
+        xr_meta.get_mpi_meta(da) is None,
+    )
+
+    xr_meta.set_mpi_meta(
+        da, dim="x", global_size=global_size, start=start, stop=stop, chunk_info={}
+    )
+    meta = xr_meta.get_mpi_meta(da)
+    check(
+        "mpi_meta round trip: dim/global_size/start/stop all match",
+        meta is not None
+        and meta["dim"] == "x"
+        and meta["global_size"] == global_size
+        and meta["start"] == start
+        and meta["stop"] == stop,
+    )
+
+    stripped = xr_meta.strip_mpi_meta(da)
+    check(
+        "strip_mpi_meta: removes the metadata from the returned object",
+        xr_meta.get_mpi_meta(stripped) is None,
+    )
+    check(
+        "strip_mpi_meta: does not mutate the original object",
+        xr_meta.get_mpi_meta(da) is not None,
+    )
+
+    mismatched = da.isel(x=slice(0, 1)).copy()
+    mismatched.attrs[xr_meta.MPI_META] = dict(da.attrs[xr_meta.MPI_META])
+    check(
+        "get_mpi_meta: rejects metadata whose declared length no longer "
+        "matches the data",
+        (stop - start) <= 1 or xr_meta.get_mpi_meta(mismatched) is None,
+    )
+
+    ds = da.to_dataset()
+    check(
+        "get_mpi_meta: Dataset.attrs is empty right after to_dataset()",
+        ds.attrs.get(xr_meta.MPI_META) is None,
+    )
+    ds_meta = xr_meta.get_mpi_meta(ds)
+    check(
+        "get_mpi_meta: falls back to variable-level metadata for a Dataset",
+        ds_meta is not None
+        and ds_meta["dim"] == "x"
+        and ds_meta["start"] == start
+        and ds_meta["stop"] == stop,
+    )
