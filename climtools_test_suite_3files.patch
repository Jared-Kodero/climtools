+def test_short_partition_warning_dedup() -> None:
+    """The short-partition warning fires once per distinct (dim, length,
+    mpi_size), and is gated to rank 0 when a rank is supplied."""
+    dim = f"__test_probe_{mpi.comm.rank}__"
+    xr_meta._SHORT_PARTITION_WARNED.discard((dim, 1, SIZE))
+
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+        for _ in range(5):
+            xr_meta.choose_partition_dim({dim: 1}, SIZE)
+    user_warnings = [w for w in caught if issubclass(w.category, UserWarning)]
+    check(
+        "choose_partition_dim: short-partition warning fires once, not per call",
+        SIZE <= 1 or len(user_warnings) == 1,
+    )
+
+    rank_dim = f"__test_probe_rank_gated_{mpi.comm.rank}__"
+    xr_meta._SHORT_PARTITION_WARNED.discard((rank_dim, 1, SIZE))
+    with warnings.catch_warnings(record=True) as gated:
+        warnings.simplefilter("always")
+        xr_meta.choose_partition_dim({rank_dim: 1}, SIZE, rank=mpi.comm.rank)
+    gated_warnings = [w for w in gated if issubclass(w.category, UserWarning)]
+    expected = 1 if mpi.comm.rank == 0 else 0
+    check(
+        "choose_partition_dim: rank= gates the warning to rank 0",
+        SIZE <= 1 or len(gated_warnings) == expected,
+    )
+
