+def test_chunk_alignment_holds_and_get_chunk_bounds() -> None:
+    """chunk-aligned bounds are used only when the chunk grid gives every
+    rank at least one chunk; otherwise get_chunk_bounds falls back to
+    get_balanced_bounds, and either way every rank's slab is on a chunk
+    boundary or covers the full remainder."""
+    length, chunk_size = 100, 8
+    aligned = chunk_alignment_holds(length, chunk_size, SIZE)
+    check(
+        "chunk_alignment_holds: true when chunk_count >= min(length, size)",
+        aligned == (int(np.ceil(length / chunk_size)) >= min(length, SIZE)),
+    )
+
+    bounds = [get_chunk_bounds(length, chunk_size, rank, SIZE) for rank in range(SIZE)]
+    check(
+        "get_chunk_bounds: contiguous, gapless partition",
+        bounds[0][0] == 0
+        and bounds[-1][1] == length
+        and all(bounds[i][1] == bounds[i + 1][0] for i in range(SIZE - 1)),
+    )
+    if aligned:
+        check(
+            "get_chunk_bounds: aligned starts fall on chunk boundaries",
+            all(start % chunk_size == 0 for start, _ in bounds[:-1] if start < length),
+        )
+
+    check(
+        "get_chunk_bounds: zero-length dimension yields (0, 0) on every rank",
+        all(
+            get_chunk_bounds(0, chunk_size, rank, SIZE) == (0, 0)
+            for rank in range(SIZE)
+        ),
+    )
+
+    # A chunk far larger than the communicator can use gives too few chunks
+    # to hand one to every rank, so this must fall back to balanced bounds
+    # rather than leaving trailing ranks with an aligned-but-empty slab.
+    huge_chunk = length + 1
+    fallback_ok = not chunk_alignment_holds(length, huge_chunk, SIZE) or SIZE == 1
+    if fallback_ok:
+        for rank in range(SIZE):
+            check(
+                f"get_chunk_bounds: falls back to balanced bounds for an "
+                f"oversized chunk (rank {rank})",
+                get_chunk_bounds(length, huge_chunk, rank, SIZE)
+                == get_balanced_bounds(length, rank, SIZE),
+            )
+
