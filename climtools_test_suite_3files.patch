+def test_get_balanced_bounds_covers_and_partitions() -> None:
+    """Bounds from every rank concatenate to exactly [0, length), for a
+    length shorter than, equal to, and longer than the communicator."""
+    for length in sorted({1, max(1, SIZE - 1), SIZE, SIZE + 1, 4 * SIZE + 3}):
+        bounds = [get_balanced_bounds(length, rank, SIZE) for rank in range(SIZE)]
+        check(
+            f"get_balanced_bounds: contiguous, gapless partition of length {length}",
+            bounds[0][0] == 0
+            and bounds[-1][1] == length
+            and all(bounds[i][1] == bounds[i + 1][0] for i in range(SIZE - 1)),
+        )
+        sizes = [max(0, stop - start) for start, stop in bounds]
+        check(
+            f"get_balanced_bounds: sizes balanced within 1 for length {length}",
+            max(sizes) - min(sizes) <= 1,
+        )
+
