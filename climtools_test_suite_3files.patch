+def test_get_chunk_info_and_overrides_and_prune() -> None:
+    """get_chunk_info sizes every dimension; get_chunk_overrides keeps only
+    dimensions without a usable native chunk; prune_chunk_info restricts a
+    mapping to a specific object's own dimensions."""
+    ds = xr.Dataset(
+        {"field": (("t", "x"), np.zeros((23, 4)))},
+        coords={"t": np.arange(23), "x": np.arange(4)},
+    )
+    info = get_chunk_info(ds, SIZE)
+    check(
+        "get_chunk_info: covers every dimension",
+        set(info) == {"t", "x"},
+    )
+    check(
+        "get_chunk_info: no encoded chunks, so both dims balance across ranks",
+        info["t"] == max(1, int(np.ceil(23 / SIZE)))
+        and info["x"] == max(1, int(np.ceil(4 / SIZE))),
+    )
+
+    overrides = get_chunk_overrides(ds, info)
+    check(
+        "get_chunk_overrides: every dim needs an override with no native chunking",
+        set(overrides) == {"t", "x"} and overrides == info,
+    )
+
+    check(
+        "get_native_chunk_sizes: no encoding on any variable returns None",
+        get_native_chunk_sizes(ds, "t") is None,
+    )
+
+    da = ds["field"]
+    pruned = prune_chunk_info({"t": 5, "x": 2, "unrelated": 9}, da)
+    check(
+        "prune_chunk_info: restricts to the object's own dims",
+        pruned == {"t": 5, "x": 2},
+    )
